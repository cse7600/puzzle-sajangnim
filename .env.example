# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude API (AI 블로그 생성 등)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (환영 메일 등 트랜잭셔널 메일)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM='퍼즐 사장님 <noreply@example.com>'

# 카카오 로그인 — 카카오 개발자 앱/Supabase Auth Provider 설정 전까지 false로 유지
NEXT_PUBLIC_KAKAO_ENABLED=false

# 관리자 대시보드(/admin) 접근을 허용할 이메일, 쉼표로 구분
ADMIN_EMAILS=admin@example.com

# 관리자 공유 비밀번호 진입 게이트
# bcrypt(cost 12) 해시를 base64로 감싼 값 — dotenv가 해시 안의 $ 문자를 확장하는 문제를 피하기 위함.
# 디코드: Buffer.from(value, 'base64').toString('utf8') → $2b$12$... 형태의 실제 bcrypt 해시
ADMIN_ENTRY_PASSWORD_HASH_B64=<base64로 감싼 bcrypt 해시>
# 관리자/QA 세션 쿠키(jose HS256) 서명 키 — 32바이트 랜덤 값, base64url
ADMIN_SESSION_SECRET=<32 random bytes, base64url>
# QA 모드에서 대신 로그인할 고정 테스트 사용자 ID
QA_USER_ID=00000000-0000-0000-0000-000000000001
